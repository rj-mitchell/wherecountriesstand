# Bring Where Countries Stand's data up to date: new General Assembly votes, new and corrected Security Council
# records, the General Debate, the search index, and up to an hour of meaning search. Installed by deploy/update.sh
# with wcs-update.timer (docs/OPERATIONS.md). Reports go to /data/logs/ in the data volume.
[Unit]
Description=Where Countries Stand: update data
After=docker.service
Requires=docker.service
# Emails the alerts address if this fails (deploy/alert@.service in Where They Stand, docs/HOSTING.md there)
OnFailure=alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wherecountriesstand/deploy
# Exits 1 when something needs attention; the report is in /data/logs/update-*.json.
ExecStart=/usr/bin/docker compose run --rm -T app wcs update --embed-seconds 3600
Nice=10
TimeoutStartSec=3h
