# Copy to .env (never commit it) and fill in.

# The site's address. Point its DNS A (and AAAA) record, and www's, at this server before starting Caddy.
DOMAIN=example.org

# Anthropic API key for written briefings. Without one the site shows the sources only.
# Spending is capped in config/settings.toml ([usage]: daily_spend_cap_usd, monthly_spend_cap_usd).
WCS_ANTHROPIC_API_KEY=

# The General Debate corpus (Harvard Dataverse) asks for a guestbook entry before it can be downloaded: the name and
# email to give. The first load (wcs bootstrap) downloads it with these.
WCS_GUESTBOOK_NAME=
WCS_GUESTBOOK_EMAIL=
