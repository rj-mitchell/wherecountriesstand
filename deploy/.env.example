# Copy to .env (never commit it) and fill in.

# The site's address (for its links, sitemap and link previews). Where MPs Stand's web server serves it, once the
# domain is in its SITES setting and has its certificate (docs/DEPLOY.md).
DOMAIN=wherecountriesstand.com

# Anthropic API key for written briefings. Without one the site shows the sources only.
# Spending is capped in config/settings.toml ([usage]: daily_spend_cap_usd, monthly_spend_cap_usd).
WCS_ANTHROPIC_API_KEY=

# The General Debate corpus (Harvard Dataverse) asks for a guestbook entry before it can be downloaded: the name and
# email to give. The first load (wcs bootstrap) downloads it with these.
WCS_GUESTBOOK_NAME=
WCS_GUESTBOOK_EMAIL=

# Off-site copies of the nightly backup (Backblaze B2). The charity's sites share one bucket and key: copy them
# from Where MPs Stand's settings with the command in docs/DEPLOY.md ("Backups"), rather than by hand.
WCS_B2_BUCKET=
WCS_B2_KEY_ID=
WCS_B2_APPLICATION_KEY=
