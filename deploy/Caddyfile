{$DOMAIN} {
	encode zstd gzip
	# flush_interval -1 streams briefings to the browser as they are written (server-sent events)
	reverse_proxy app:8000 {
		flush_interval -1
		# the visitor's own address only, never one a visitor added themselves (rate limits use it, hashed)
		header_up X-Forwarded-For {remote_host}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# everything comes from this site: the fonts are served here, and there are no outside scripts
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-ancestors 'none'"
		+Cache-Control "no-transform"
	}
}

# www goes to the main address
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
